# Copy to .env:  cp .env.example .env
# The localhost URLs below are for running the API directly on your machine.
# docker-compose overrides them with container hostnames automatically.

# ─── App ───────────────────────────────────────────────
APP_NAME=Kairos
APP_ENV=development          # development | production
DEBUG=true                   # false in production (disables /docs, strict CORS)

# ─── Database ──────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://kairos_user:kairos_pass@localhost:5432/kairos_db

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Kafka (optional) ──────────────────────────────────
# Set KAFKA_ENABLED=false when no broker is available — events are still stored in Postgres
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── Auth ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ──────────────────────────────────────────────
# Comma-separated frontend origins, used when DEBUG=false
CORS_ORIGINS=http://localhost:5173

# ─── Pricing ───────────────────────────────────────────
# How often (seconds) the background repricer lets decayed demand bring prices back. 0 = off
REPRICE_INTERVAL_SECONDS=60

# ─── Stripe (optional) ─────────────────────────────────
# Leave these placeholders to use MOCK payments (a "Simulate payment" button in the UI).
# For real test-mode payments use keys from https://dashboard.stripe.com/test/apikeys
# and set VITE_STRIPE_PUBLISHABLE_KEY in frontend/.env
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
